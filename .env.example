# ---------------------------------------------------------------------------
# Parlo configuration. Copy to .env and fill in:  cp .env.example .env
#
# Keep comments on their own lines: Docker Compose treats "KEY=   # note" as
# the value "# note".
#
# Admins can override provider / model / voice settings at runtime from the
# admin panel (stored in the DB); the values here are the defaults.
# ---------------------------------------------------------------------------

# === Core ===================================================================
# Public hostname (used by standalone Caddy HTTPS and push notifications)
DOMAIN=lang.wharveytech.com
# Host port Caddy is published on (bound to 127.0.0.1 for the host Nginx)
PORT=7892
# Long random strings:  openssl rand -hex 32
APP_SECRET=change-me
POSTGRES_PASSWORD=change-me
# open | invite | closed  (the very first account is always allowed and becomes admin)
REGISTRATION_MODE=invite
RECORDING_RETENTION_DAYS=30
# false = keep transcripts only, never store voice recordings
STORE_RECORDINGS=true
# auto (from X-Forwarded-Proto) | true | false
COOKIE_SECURE=auto
API_WORKERS=2

# === LLM ====================================================================
# gemini | anthropic | openai | openrouter | openai_compatible
LLM_PROVIDER=gemini
# Gemini API key from https://aistudio.google.com/apikey — the project must be on the PAID tier
LLM_API_KEY=
# Only for openai_compatible / Ollama, e.g. http://ollama:11434/v1
LLM_BASE_URL=
# Models per task. Empty = provider default (Gemini: gemini-3.8-flash for all three)
# fast/cheap model for conversation replies
LLM_MODEL_CONVERSATION=
# stronger model for per-turn feedback, judging and summaries
LLM_MODEL_FEEDBACK=
# strongest model, used for lesson generation
LLM_MODEL_CONTENT=

# === TTS ====================================================================
# local | openai | google | elevenlabs | azure  (lessons and conversation can differ)
TTS_PROVIDER_LESSON=google
TTS_PROVIDER_CONVERSATION=google
# Google Cloud API key restricted to the Text-to-Speech API...
TTS_API_KEY=
# ...or a service-account JSON placed in ./secrets, e.g. /secrets/google-tts.json
GOOGLE_APPLICATION_CREDENTIALS=
# Only for local / OpenAI-compatible servers, e.g. http://tts:8880/v1
TTS_BASE_URL=
# Only for azure, e.g. westeurope
TTS_AZURE_REGION=
# Voices. Empty = defaults (Google: <locale>-Chirp3-HD-Aoede female, -Charon male)
TTS_VOICE_FR=
TTS_VOICE_IT=
TTS_VOICE_JA=
TTS_VOICE_FR_MALE=
TTS_VOICE_IT_MALE=
TTS_VOICE_JA_MALE=

# === STT ====================================================================
# gemini | openai | groq | deepgram | google_cloud | local
STT_PROVIDER=gemini
# Defaults to LLM_API_KEY when the provider is gemini
STT_API_KEY=
# Only for local / OpenAI-compatible servers, e.g. http://stt:8000/v1
STT_BASE_URL=
# Empty = provider default (Gemini: gemini-3.8-flash)
STT_MODEL=
# true = one Gemini call returns transcript + feedback (saves a round trip)
STT_COMBINED_FEEDBACK=false

# === Optional per-provider keys (used if an admin switches provider at runtime)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=

# === Limits =================================================================
# Soft cap per user per day (UTC): warns at 80%, blocks at 100% (admins exempt)
DAILY_AI_BUDGET_USD=2.00
# AI requests per user per minute
RATE_LIMIT_PER_MIN=30
MAX_RECORDING_SECONDS=60
# Lessons generated ahead of each learner
PREGENERATE_AHEAD=3

# === Web push reminders (generated automatically when empty) ================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact sent to push services
VAPID_SUBJECT=

# === Backups ================================================================
# How many of each backup file to keep, and the hour (UTC) the optional
# `backup` compose service runs (docker compose --profile backup up -d)
BACKUP_KEEP=7
BACKUP_HOUR=3
# If set, scripts/backup.sh encrypts every backup file with gpg (AES-256)
BACKUP_PASSPHRASE=
